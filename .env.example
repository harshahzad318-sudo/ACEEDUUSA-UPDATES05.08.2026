# ==============================================================================
# ACE Education USA - Comprehensive Production Environment Variable Template
# ==============================================================================
# This template lists all environment variables required or optional for 
# operating ACE Education USA in local development and live Cloud Run production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# [REQUIRED] PostgreSQL database connection string for persistent cloud storage.
# Example: postgresql://user:password@cloudsql-instance:5432/ace_production
DATABASE_URL=postgresql://ace_user:your_db_password_here@127.0.0.1:5432/ace_production

# [REQUIRED] Main platform support email displayed on invoices and emails.
# Example: info@aceeducation.us
ADMIN_EMAIL=info@aceeducation.us

# [REQUIRED] Public base URL of the deployed application used for canonical redirects and webhooks.
# Example: https://aceeducation.us
NEXT_PUBLIC_APP_URL=https://aceeducation.us

# ------------------------------------------------------------------------------
# 2. AI ENGINE (GOOGLE GEMINI API)
# ------------------------------------------------------------------------------
# [REQUIRED] Google Gemini API Key for strategic BI recommendation engine and executive insights.
# Example: your_gemini_api_key_here
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. STRIPE PAYMENT GATEWAY INTEGRATION
# ------------------------------------------------------------------------------
# [OPTIONAL / RECOMMENDED] Stripe secret key for live and test payment processing.
# Example: your_stripe_secret_key_here
STRIPE_SECRET_KEY=

# [OPTIONAL / RECOMMENDED] Stripe publishable key for client-side checkout components.
# Example: your_stripe_publishable_key_here
STRIPE_PUBLISHABLE_KEY=

# [OPTIONAL] Stripe webhook signing secret for verifying payment completion events.
# Example: your_stripe_webhook_secret_here
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL PROVIDER (SMTP)
# ------------------------------------------------------------------------------
# [OPTIONAL / RECOMMENDED] Hostname of the SMTP server for sending automated transactional emails.
# Example: smtp.gmail.com or sendgrid.net
SMTP_HOST=smtp.gmail.com

# [OPTIONAL / RECOMMENDED] SMTP port (587 for TLS, 465 for SSL).
# Example: 587
SMTP_PORT=587

# [OPTIONAL / RECOMMENDED] Username / email address for SMTP authentication.
# Example: notifications@aceeducation.us
SMTP_USER=notifications@aceeducation.us

# [OPTIONAL / RECOMMENDED] Password or app-specific token for SMTP authentication.
# Example: your_app_password_here
SMTP_PASS=your_smtp_app_password_here

# [OPTIONAL / RECOMMENDED] From address header for outbound emails.
# Example: "ACE Education USA" <notifications@aceeducation.us>
SMTP_FROM="ACE Education USA" <notifications@aceeducation.us>

# ------------------------------------------------------------------------------
# 5. TWILIO SMS INTEGRATION
# ------------------------------------------------------------------------------
# [OPTIONAL] Twilio Account SID for sending lesson reminders and verification SMS.
# Example: ACabcdefghijklmnopqrstuvwxyz123456
TWILIO_ACCOUNT_SID=ACExampleTwilioAccountSid123456789

# [OPTIONAL] Twilio Auth Token for API request authorization.
# Example: 1234567890abcdef1234567890abcdef
TWILIO_AUTH_TOKEN=ExampleTwilioAuthToken1234567890

# [OPTIONAL] Twilio phone number in E.164 format.
# Example: +13322936270
TWILIO_PHONE_NUMBER=+13322936270

# ------------------------------------------------------------------------------
# 6. GOOGLE CLOUD STORAGE (DOCUMENT & HOMEWORK VAULT)
# ------------------------------------------------------------------------------
# [OPTIONAL / RECOMMENDED] Google Cloud Storage bucket name for file storage.
# Example: ace-education-storage-prod
GCS_BUCKET_NAME=ace-education-storage-prod

# [OPTIONAL / RECOMMENDED] Google Cloud Platform Project ID.
# Example: ace-education-us-prod
GCS_PROJECT_ID=ace-education-us-prod

# [OPTIONAL / RECOMMENDED] Service account client email for GCS access.
# Example: gcs-storage-sa@ace-education-us-prod.iam.gserviceaccount.com
GCS_CLIENT_EMAIL=gcs-sa@ace-education-us-prod.iam.gserviceaccount.com

# [OPTIONAL / RECOMMENDED] Private key for service account (formatted with newline breaks).
# Example: "-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwg..."
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nEXAMPLE_GCS_PRIVATE_KEY\n-----END PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 7. GOOGLE MAPS PLATFORM
# ------------------------------------------------------------------------------
# [OPTIONAL] Google Maps API key for calculating tutor travel distance and buffer times.
# Example: your_google_maps_api_key_here
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 8. VIDEO MEETING PLATFORMS (ZOOM & MICROSOFT TEAMS)
# ------------------------------------------------------------------------------
# [OPTIONAL] Zoom OAuth / Server-to-Server API Key for generating meeting links.
# Example: ZoomApiKey12345
ZOOM_API_KEY=ExampleZoomApiKey12345

# [OPTIONAL] Zoom API Secret for signature verification.
# Example: ZoomSecret67890
ZOOM_API_SECRET=ExampleZoomApiSecret67890

# [OPTIONAL] Microsoft Azure Tenant ID for Teams meeting integration.
# Example: 00000000-0000-0000-0000-000000000000
TEAMS_TENANT_ID=00000000-0000-0000-0000-000000000000

# ------------------------------------------------------------------------------
# 9. GOOGLE CALENDAR SYNC INTEGRATION
# ------------------------------------------------------------------------------
# [OPTIONAL] Google OAuth Client ID for Google Calendar synchronization.
# Example: 123456789-abc.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_ID=1234567890-example.apps.googleusercontent.com

# [OPTIONAL] Google OAuth Client Secret for Google Calendar synchronization.
# Example: GOCSPX-ExampleSecret12345
GOOGLE_CALENDAR_CLIENT_SECRET=GOCSPX-ExampleSecret12345

# ------------------------------------------------------------------------------
# 11. MARKETING ANALYTICS & CONVERSION TRACKING
# ------------------------------------------------------------------------------
# [OPTIONAL] Google Analytics Measurement ID (e.g. G-XXXXXXX)
NEXT_PUBLIC_GA_ID=G-EXAMPLE123456

# [OPTIONAL] Google Tag Manager Container ID (e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=GTM-EXAMPLE1234

# [OPTIONAL] Microsoft Clarity Project Tag ID
NEXT_PUBLIC_CLARITY_ID=clarity_example_tag

# [OPTIONAL] Meta / Facebook Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# [OPTIONAL] LinkedIn Insight Tag Partner ID
NEXT_PUBLIC_LINKEDIN_INSIGHT_ID=1234567

# [OPTIONAL] Google Ads Conversion Tag ID (e.g. AW-123456789)
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-123456789

